+        const uint32_t span = (s_mt[s].size + MT_UNIT - 1u) & ~(MT_UNIT - 1u);
+        for (uint32_t a = addr; a - addr < span; a += MT_UNIT) s_page_owner[a / MT_UNIT] = 0;
+        s_mt[s].mapped = 0;
