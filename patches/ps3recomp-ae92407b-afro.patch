+            ReleaseSRWLockExclusive(&s_mt_lock);
+            *va = (uint32_t)a;
+            return 0;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_mt_lock);
+    { static int n = 0; if (PS3_LOG_FIRST(n, 4))
+        fprintf(stderr, "[mmapper] search_and_map: no room for 0x%X in 0x%08X..0x%08X\n",
+                s_mt[s].size, lo, hi); }
+    return (int64_t)(int32_t)0x80010004u;   /* ENOMEM */
+}
