diff --git a/libs/input/host_input.h b/libs/input/host_input.h
new file mode 100644
index 00000000..1221f311
--- /dev/null
+++ b/libs/input/host_input.h
@@ -0,0 +1,74 @@
+/*
+ * ps3recomp - keyboard and mouse state handed to the host pad (cellPad.c)
+ *
+ * The keyboard/mouse pad reads one of these. Whoever owns the window fills
+ * it in:
+ *
+ *   - the window host (tools/host_window, macOS): the window lives in the
+ *     launcher process and the game has none, so the block sits in the
+ *     control page both processes map (rsx_host_surface.h). The launcher
+ *     writes key and mouse state, the game reads it -- no messages, no
+ *     extra thread, and it survives the game's exec like the rest of the
+ *     page;
+ *   - the Metal backend's own window (no window host): a block in the game
+ *     process that the backend's event pump fills.
+ *
+ * Every field is a lock-free 32-bit atomic, so the two processes can share
+ * it through the mapped page.
+ *
+ *   keys[4]          macOS virtual key codes 0-127 held down, one bit each
+ *   mouse_dx/dy      motion since the game last drained it, 1/16 px
+ *                    (deltaY > 0 = down); the game exchanges it with 0
+ *   wheel            wheel turns since the last drain, 1/16 lines, + = away
+ *                    from the player whatever the scroll-direction setting
+ *   mouse_buttons    bit n = NSEvent buttonNumber n (1 left, 2 right,
+ *                    4 middle, 8 button 4, ...)
+ *   game_flags       written by the game: what the window should do with
+ *                    the mouse (PS3_HOST_INPUT_*)
+ *   captured         written by the window: 1 while the cursor is captured
+ *
+ * Plain C, header only: cellPad.c, the Metal backend, the window host and the
+ * tests share it.
+ *
+ * This tree keeps the header beside cellPad.c (libs/input/host_input.h); the
+ * tree it comes from has it as include/ps3emu/host_input.h. Same contents.
+ */
+#ifndef PS3EMU_HOST_INPUT_H
+#define PS3EMU_HOST_INPUT_H
+
+#include <stdatomic.h>
+#include <stdint.h>
+
+/* game_flags */
+#define PS3_HOST_INPUT_MOUSE_CAMERA  0x1u   /* the mouse turns the camera now */
+#define PS3_HOST_INPUT_CAPTURE       0x2u   /* ... and wants the cursor captured on a click */
+#define PS3_HOST_INPUT_ACTIVE        0x4u   /* a cellPad that reads this block is running */
+
+typedef struct {
+    _Atomic uint32_t keys[4];
+    _Atomic int32_t  mouse_dx, mouse_dy, wheel;
+    _Atomic uint32_t mouse_buttons;
+    _Atomic uint32_t game_flags;
+    _Atomic uint32_t captured;
+    uint32_t         reserved[6];
+} ps3_host_input;
+
+_Static_assert(sizeof(ps3_host_input) == 64, "ps3_host_input layout");
+
+/* A key went down (1) or up (0). */
+static inline void ps3_host_input_key(ps3_host_input* in, unsigned vk, int down)
+{
+    vk &= 127u;
+    if (down) atomic_fetch_or(&in->keys[vk >> 5], 1u << (vk & 31));
+    else      atomic_fetch_and(&in->keys[vk >> 5], ~(1u << (vk & 31)));
+}
+
+/* Nothing held: focus went elsewhere, so no key-up will arrive. */
+static inline void ps3_host_input_release_all(ps3_host_input* in)
+{
+    for (int i = 0; i < 4; i++) atomic_store(&in->keys[i], 0);
+    atomic_store(&in->mouse_buttons, 0);
+    atomic_store(&in->wheel, 0);
+}
+
+#endif /* PS3EMU_HOST_INPUT_H */
diff --git a/libs/input/host_input_cocoa.h b/libs/input/host_input_cocoa.h
new file mode 100644
index 00000000..d25681b3
--- /dev/null
+++ b/libs/input/host_input_cocoa.h
@@ -0,0 +1,166 @@
+/*
+ * ps3recomp - AppKit events -> the keyboard/mouse pad's ps3_host_input block
+ *
+ * The window that shows the game turns its key and mouse events into the
+ * block cellPad.c reads (ps3emu/host_input.h). Two windows do that and share
+ * this header: the window host (tools/host_window, whose block is in the
+ * control page the game maps) and the Metal backend's own window
+ * (rsx_metal_backend.m, a block in the game process).
+ *
+ *   keys            recorded by macOS virtual key code and swallowed (an
+ *                   unhandled key beeps); a key typed with Cmd held is the
+ *                   menu's and goes on to AppKit untouched. Shift, Control
+ *                   and Option are keys too, from their flag changes.
+ *   mouse camera    when the game asks for it (game_flags): with capture on,
+ *                   a left click in the game captures the cursor (that click
+ *                   presses nothing) and motion, buttons and the wheel count
+ *                   only while captured; Esc, Cmd, another window or another
+ *                   app release it. Esc still reaches the pad (START by
+ *                   default: pause). With capture off, motion counts
+ *                   whenever the window is key. Mouse events always go on to
+ *                   AppKit (focus, the title bar).
+ *
+ * Main thread only. hic_event first for every event, hic_tick now and then
+ * (it lets go of what the game no longer wants and of everything when the
+ * app loses focus).
+ */
+#ifndef PS3RECOMP_HOST_INPUT_COCOA_H
+#define PS3RECOMP_HOST_INPUT_COCOA_H
+
+#import <AppKit/AppKit.h>
+#include <math.h>
+#include "host_input.h"   /* include/ps3emu/host_input.h in the upstream tree */
+
+typedef struct {
+    ps3_host_input* in;
+    int             captured;
+    double          cap_since;   /* motion from before the capture is not the game's */
+} HostInputCocoa;
+
+static inline void hic_release(HostInputCocoa* s)
+{
+    if (!s->captured) return;
+    s->captured = 0;
+    CGAssociateMouseAndMouseCursorPosition(true);
+    [NSCursor unhide];
+    atomic_store(&s->in->mouse_buttons, 0);
+    atomic_store(&s->in->captured, 0);
+}
+
+static inline void hic_capture(HostInputCocoa* s, NSWindow* w)
+{
+    if (s->captured || !w) return;
+    /* Park the cursor in the middle of the game, so it comes back there and
+     * not wherever the motion would have carried it. CG's global space has
+     * its origin at the top left of the primary screen, AppKit's at the
+     * bottom left. */
+    const NSRect r = [w convertRectToScreen:[[w contentView] frame]];
+    NSArray<NSScreen*>* screens = [NSScreen screens];
+    if (screens.count) {
+        const CGFloat top = NSMaxY(screens[0].frame);
+        CGWarpMouseCursorPosition(CGPointMake(NSMidX(r), top - NSMidY(r)));
+    }
+    CGAssociateMouseAndMouseCursorPosition(false);
+    [NSCursor hide];
+    s->captured  = 1;
+    s->cap_since = [[NSProcessInfo processInfo] systemUptime] + 0.05;
+    atomic_store(&s->in->mouse_dx, 0);
+    atomic_store(&s->in->mouse_dy, 0);
+    atomic_store(&s->in->captured, 1);
+}
+
+/* Focus went elsewhere: no key-up or mouse-up will arrive. */
+static inline void hic_focus_lost(HostInputCocoa* s)
+{
+    ps3_host_input_release_all(s->in);
+    hic_release(s);
+}
+
+static inline void hic_tick(HostInputCocoa* s)
+{
+    const uint32_t f = atomic_load(&s->in->game_flags);
+    const uint32_t want = PS3_HOST_INPUT_MOUSE_CAMERA | PS3_HOST_INPUT_CAPTURE;
+    if (s->captured && (f & want) != want) hic_release(s);
+    if (![NSApp isActive]) hic_focus_lost(s);
+}
+
+/* 1 = the event was the pad's (swallow it), 0 = pass it on to AppKit. */
+static inline int hic_event(HostInputCocoa* s, NSEvent* ev, NSWindow* w)
+{
+    ps3_host_input* in = s->in;
+    const NSEventType t = [ev type];
+    const uint32_t f = atomic_load(&in->game_flags);
+    const int camera = (f & PS3_HOST_INPUT_MOUSE_CAMERA) != 0;
+    const int cap_on = (f & PS3_HOST_INPUT_CAPTURE) != 0;
+    const int key_win = w && [w isKeyWindow];
+
+    switch (t) {
+    case NSEventTypeMouseMoved: case NSEventTypeLeftMouseDragged:
+    case NSEventTypeRightMouseDragged: case NSEventTypeOtherMouseDragged: {
+        const int take = camera && (cap_on ? (s->captured && [ev timestamp] >= s->cap_since) : key_win);
+        if (take) {
+            atomic_fetch_add(&in->mouse_dx, (int32_t)lround([ev deltaX] * 16.0));
+            atomic_fetch_add(&in->mouse_dy, (int32_t)lround([ev deltaY] * 16.0));
+        }
+        return 0;
+    }
+    case NSEventTypeLeftMouseDown:  case NSEventTypeLeftMouseUp:
+    case NSEventTypeRightMouseDown: case NSEventTypeRightMouseUp:
+    case NSEventTypeOtherMouseDown: case NSEventTypeOtherMouseUp: {
+        uint32_t bit = 1u;
+        if (t == NSEventTypeRightMouseDown || t == NSEventTypeRightMouseUp) bit = 2u;
+        if (t == NSEventTypeOtherMouseDown || t == NSEventTypeOtherMouseUp) {
+            const NSInteger n = [ev buttonNumber];   /* middle = 4, button 4 = 8, ... */
+            bit = 1u << (n < 2 ? 2 : n > 7 ? 7 : n);
+        }
+        const int down = (t == NSEventTypeLeftMouseDown || t == NSEventTypeRightMouseDown ||
+                          t == NSEventTypeOtherMouseDown);
+        if (!down) { atomic_fetch_and(&in->mouse_buttons, ~bit); return 0; }
+        if (!camera || !w || [ev window] != w) return 0;
+        const int inside = NSPointInRect([ev locationInWindow], [[w contentView] frame]);
+        if (!cap_on) {
+            if (inside && key_win) atomic_fetch_or(&in->mouse_buttons, bit);
+        } else if (s->captured) {
+            atomic_fetch_or(&in->mouse_buttons, bit);
+        } else if (inside && bit == 1u) {
+            hic_capture(s, w);
+        }
+        return 0;
+    }
+    case NSEventTypeScrollWheel:
+        if (camera && (cap_on ? s->captured : ([ev window] == w && key_win))) {
+            const double dy = [ev isDirectionInvertedFromDevice] ? -[ev deltaY] : [ev deltaY];
+            atomic_fetch_add(&in->wheel, (int32_t)lround(dy * 16.0));
+        }
+        return 0;
+    case NSEventTypeFlagsChanged: {
+        /* Cmd releases the mouse, so Cmd+Tab and the rest of the system's
+         * shortcuts find a cursor. */
+        if (s->captured && ([ev modifierFlags] & NSEventModifierFlagCommand)) hic_release(s);
+        /* the device-dependent bits tell left from right */
+        static const struct { unsigned short vk; NSUInteger bit; } mods[] = {
+            {0x38, 0x02}, {0x3C, 0x04},       /* Shift, right Shift */
+            {0x3B, 0x01}, {0x3E, 0x2000},     /* Control, right Control */
+            {0x3A, 0x20}, {0x3D, 0x40},       /* Option, right Option */
+        };
+        const unsigned vk = [ev keyCode] & 127u;
+        for (unsigned i = 0; i < sizeof mods / sizeof mods[0]; i++)
+            if (mods[i].vk == vk) ps3_host_input_key(in, vk, ([ev modifierFlags] & mods[i].bit) != 0);
+        return 0;
+    }
+    case NSEventTypeKeyDown: {
+        if ([ev modifierFlags] & NSEventModifierFlagCommand) return 0;   /* the menu's */
+        const unsigned vk = [ev keyCode] & 127u;
+        if (vk == 0x35) hic_release(s);                                   /* Esc */
+        ps3_host_input_key(in, vk, 1);
+        return 1;
+    }
+    case NSEventTypeKeyUp:
+        ps3_host_input_key(in, [ev keyCode] & 127u, 0);
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+#endif /* PS3RECOMP_HOST_INPUT_COCOA_H */
diff --git a/libs/input/pad_input_map.h b/libs/input/pad_input_map.h
new file mode 100644
index 00000000..9b83edab
--- /dev/null
+++ b/libs/input/pad_input_map.h
@@ -0,0 +1,708 @@
+/*
+ * ps3recomp - input mapping file for the host pad (cellPad.c)
+ *
+ * PS3_INPUT_MAP=<path> names a small text file (a TOML subset; an .ini
+ * written the same way reads the same) that rebinds the keyboard, the mouse
+ * buttons and a controller's buttons to PS3 controls, and holds the mouse
+ * camera's settings. Every control or setting the file leaves out keeps its
+ * built-in default (pim_defaults), so an empty or missing file is exactly
+ * the built-in layout. Names are case-insensitive; an unknown section, control
+ * or input name is reported once on stderr and ignored.
+ *
+ *   # comments start with '#' or ';'
+ *   [keyboard]                 # PS3 control = keys
+ *   cross    = "Space"
+ *   start    = "Return, KeypadEnter"     # several keys: a list ...
+ *   select   = ["Tab", "Backspace"]      # ... or a TOML array
+ *   l3       = ""                        # "" or "none": unbound
+ *   ls_up    = "W"
+ *
+ *   [mouse_buttons]            # PS3 control = mouse buttons
+ *   r1 = "Left"
+ *   r2 = "Right"
+ *   l1 = "Middle"
+ *   up = "WheelUp"
+ *
+ *   [mouse]                    # the mouse camera (right stick)
+ *   camera      = true         # PS3_MOUSE
+ *   sensitivity = 1.0          # PS3_MOUSE_SENS
+ *   invert_x    = false        # PS3_MOUSE_INVERT_X
+ *   invert_y    = false        # PS3_MOUSE_INVERT_Y
+ *   deadzone    = 30           # PS3_MOUSE_DEADZONE (0-120)
+ *   capture     = true         # PS3_MOUSE_CAPTURE: a click captures the cursor
+ *
+ *   [controller]               # PS3 control = SDL GameController inputs
+ *   cross = "a"                # (Cross on a DualSense, A on an Xbox pad)
+ *   r2    = "righttrigger"
+ *
+ * The environment variables in the comments win over the file. An input the
+ * file binds leaves the controls the file does not mention: `cross = "Q"`
+ * takes Q off its default, circle (list it under both to keep both).
+ *
+ * PS3 controls: up down left right (D-pad), cross circle square triangle,
+ * l1 r1 l2 r2 l3 r3, start select, ls_up ls_down ls_left ls_right (left
+ * stick), rs_up rs_down rs_left rs_right (right stick).
+ *
+ * Keys (macOS virtual key codes, US layout positions): A-Z, 0-9, F1-F20,
+ * Space Return Tab Escape Backspace ForwardDelete Up Down Left Right Home
+ * End PageUp PageDown Help, Minus Equal LeftBracket RightBracket Backslash
+ * Semicolon Quote Comma Period Slash Grave Section, Keypad0-Keypad9
+ * KeypadEnter KeypadPlus KeypadMinus KeypadMultiply KeypadDivide
+ * KeypadDecimal KeypadEquals KeypadClear, Shift RightShift Control
+ * RightControl Option RightOption, or a raw code as 0x00-0x7F. Cmd is the
+ * window's (it releases the mouse) and cannot be bound; Escape also releases
+ * a captured mouse, and still reaches the pad.
+ *
+ * Mouse buttons: Left Right Middle Button4-Button8 WheelUp WheelDown.
+ *
+ * Controller inputs (SDL names): a b x y back guide start leftstick
+ * rightstick leftshoulder rightshoulder dpup dpdown dpleft dpright misc1
+ * paddle1-paddle4 touchpad lefttrigger righttrigger; PlayStation and Xbox
+ * names are accepted as aliases (cross circle square triangle, l1 r1 l2 r2
+ * l3 r3, share create options ps, view menu home). The physical sticks always
+ * drive the PS3 sticks; a stick direction bound to a button pushes that
+ * axis to the end while it is held.
+ *
+ * pim_save_file writes a map back in the same form (all three binding
+ * sections in full, every other section kept as it was), which is also what
+ * the launcher's Controls screen writes in the inFAMOUS 2 port.
+ *
+ * This header is the parser and writer only (no SDL, no AppKit), so it
+ * builds into a standalone test: libs/input/tests/test_pad_input_map.c.
+ */
+#ifndef PS3RECOMP_PAD_INPUT_MAP_H
+#define PS3RECOMP_PAD_INPUT_MAP_H
+
+#include <ctype.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* PS3 controls. 0-15 are the CELL_PAD_CTRL_* bit numbers, so a mask of
+ * pressed controls is the cellPad button word in its low 16 bits. */
+enum {
+    PIM_SELECT, PIM_L3, PIM_R3, PIM_START, PIM_UP, PIM_RIGHT, PIM_DOWN, PIM_LEFT,
+    PIM_L2, PIM_R2, PIM_L1, PIM_R1, PIM_TRIANGLE, PIM_CIRCLE, PIM_CROSS, PIM_SQUARE,
+    PIM_LS_UP, PIM_LS_DOWN, PIM_LS_LEFT, PIM_LS_RIGHT,
+    PIM_RS_UP, PIM_RS_DOWN, PIM_RS_LEFT, PIM_RS_RIGHT,
+    PIM_N_CONTROLS
+};
+
+/* Mouse inputs: bit n = NSEvent buttonNumber n (1 left, 2 right, 4 middle,
+ * 8 button 4, ...), as the window keeps them in g_pad_mouse_buttons; the
+ * wheel's two directions are synthetic presses above them. */
+#define PIM_MOUSE_WHEEL_UP    (1u << 24)
+#define PIM_MOUSE_WHEEL_DOWN  (1u << 25)
+
+/* Controller inputs: bit n = SDL_GameControllerButton n (stable values since
+ * SDL 2.0; 15-20 need SDL 2.0.14+), plus the two triggers read as buttons. */
+#define PIM_PAD_TRIGGER_LEFT   21
+#define PIM_PAD_TRIGGER_RIGHT  22
+
+typedef struct {
+    uint32_t key[PIM_N_CONTROLS][4];   /* 128 key codes, like g_pad_host_keys */
+    uint32_t mouse[PIM_N_CONTROLS];
+    uint32_t pad[PIM_N_CONTROLS];
+    /* [mouse]; -1 (or 0 for sens) = not in the file */
+    int   mouse_camera, mouse_invert_x, mouse_invert_y, mouse_deadzone, mouse_capture;
+    float mouse_sens;
+    int   n_set;        /* controls/settings the file changed */
+    int   n_warnings;   /* names it did not know */
+} PadInputMap;
+
+typedef struct { const char* name; int id; } PimName;
+
+static const PimName pim_controls[] = {
+    {"select", PIM_SELECT}, {"l3", PIM_L3}, {"r3", PIM_R3}, {"start", PIM_START},
+    {"up", PIM_UP}, {"right", PIM_RIGHT}, {"down", PIM_DOWN}, {"left", PIM_LEFT},
+    {"l2", PIM_L2}, {"r2", PIM_R2}, {"l1", PIM_L1}, {"r1", PIM_R1},
+    {"triangle", PIM_TRIANGLE}, {"circle", PIM_CIRCLE}, {"cross", PIM_CROSS}, {"square", PIM_SQUARE},
+    {"ls_up", PIM_LS_UP}, {"ls_down", PIM_LS_DOWN}, {"ls_left", PIM_LS_LEFT}, {"ls_right", PIM_LS_RIGHT},
+    {"rs_up", PIM_RS_UP}, {"rs_down", PIM_RS_DOWN}, {"rs_left", PIM_RS_LEFT}, {"rs_right", PIM_RS_RIGHT},
+    /* aliases */
+    {"dpad_up", PIM_UP}, {"dpad_down", PIM_DOWN}, {"dpad_left", PIM_LEFT}, {"dpad_right", PIM_RIGHT},
+    {"left_stick_up", PIM_LS_UP}, {"left_stick_down", PIM_LS_DOWN},
+    {"left_stick_left", PIM_LS_LEFT}, {"left_stick_right", PIM_LS_RIGHT},
+    {"right_stick_up", PIM_RS_UP}, {"right_stick_down", PIM_RS_DOWN},
+    {"right_stick_left", PIM_RS_LEFT}, {"right_stick_right", PIM_RS_RIGHT},
+};
+
+static const PimName pim_keys[] = {
+    {"a", 0x00}, {"s", 0x01}, {"d", 0x02}, {"f", 0x03}, {"h", 0x04}, {"g", 0x05},
+    {"z", 0x06}, {"x", 0x07}, {"c", 0x08}, {"v", 0x09}, {"section", 0x0A}, {"b", 0x0B},
+    {"q", 0x0C}, {"w", 0x0D}, {"e", 0x0E}, {"r", 0x0F}, {"y", 0x10}, {"t", 0x11},
+    {"1", 0x12}, {"2", 0x13}, {"3", 0x14}, {"4", 0x15}, {"6", 0x16}, {"5", 0x17},
+    {"equal", 0x18}, {"9", 0x19}, {"7", 0x1A}, {"minus", 0x1B}, {"8", 0x1C}, {"0", 0x1D},
+    {"rightbracket", 0x1E}, {"o", 0x1F}, {"u", 0x20}, {"leftbracket", 0x21}, {"i", 0x22},
+    {"p", 0x23}, {"return", 0x24}, {"l", 0x25}, {"j", 0x26}, {"quote", 0x27}, {"k", 0x28},
+    {"semicolon", 0x29}, {"backslash", 0x2A}, {"comma", 0x2B}, {"slash", 0x2C},
+    {"n", 0x2D}, {"m", 0x2E}, {"period", 0x2F}, {"tab", 0x30}, {"space", 0x31},
+    {"grave", 0x32}, {"backspace", 0x33}, {"escape", 0x35},
+    {"shift", 0x38}, {"option", 0x3A}, {"control", 0x3B},
+    {"rightshift", 0x3C}, {"rightoption", 0x3D}, {"rightcontrol", 0x3E},
+    {"f17", 0x40}, {"keypaddecimal", 0x41}, {"keypadmultiply", 0x43}, {"keypadplus", 0x45},
