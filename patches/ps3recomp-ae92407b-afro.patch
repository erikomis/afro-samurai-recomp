+        if (bad && fails++ < 5)
+            printf("FAIL iter %d shape %d n %u: unique %u want %u\n", iter, shape, n, unique, want);
+    }
+    rsx_vertex_remap_destroy(&remap);
+    printf("%s (%d failures)\n", fails ? "FAILED" : "ok", fails);
