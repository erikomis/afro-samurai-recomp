+/* sys_mmapper_search_and_map (lv2 337), tracked. ppu_loader.cpp routes here. */
+extern "C" int64_t ps3_mmapper_search_and_map_tracked(uint32_t start, uint32_t mem_id, uint32_t* va)
+{
