+static uint32_t s_mt_free[MT_MAX];
+static uint32_t s_mt_free_n = 0, s_mt_hi = 0;
+static uint32_t s_page_owner[0x100000000ull / MT_UNIT];   /* mem id, 0 = free */
+static SRWLOCK  s_mt_lock = SRWLOCK_INIT;
